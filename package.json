{
  "name": "githubprint",
  "version": "0.1.0",
  "description": "Turn GitHub into a shareable, PDF-ready developer brief.",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "keywords": [
    "nextjs",
    "github",
    "portfolio",
    "developer-profile",
    "openai",
    "pdf"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:resume": "node --import tsx --test tests/resume.test.ts",
    "test:showcase": "node --import tsx --test tests/showcase-resume.test.ts",
    "test:proxy": "node --import tsx --test tests/proxy.test.ts",
    "check": "npm run build && npm run typecheck && npm run test:resume && npm run test:showcase && npm run test:proxy && npm run test:seo && npm run test:html && npm run test:copy && npm run test:privacy && npm run test:evidence && npm run quality:regress",
    "insights:aggregate": "node scripts/aggregate-insights.mjs",
    "quality:regress": "node scripts/run-quality-regressions.cjs",
    "test:documents": "playwright test",
    "test:seo": "node --import tsx --test tests/seo.test.ts",
    "test:seo:browser": "playwright test tests/browser/seo.spec.ts",
    "test:html": "node --import tsx --test tests/document-html.test.ts",
    "test:privacy": "node --require ./tests/helpers/register-runtime.cjs --test tests/private-data.test.cjs",
    "test:privacy:browser": "playwright test --config playwright.privacy.config.ts",
    "test:copy": "node --import tsx --test tests/template-composers.test.ts && node --require ./tests/helpers/register-runtime.cjs --test tests/profile-introduction.test.cjs",
    "test:evidence": "node --require ./tests/helpers/register-runtime.cjs --test tests/evidence-review.test.cjs",
    "test:docx:structure": "node scripts/validate-docx.cjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-kr": "^5.2.10",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "next": "16.3.4",
    "next-intl": "^4.14.3",
    "openai": "^6.7.0",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
